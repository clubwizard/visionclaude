# ── Multi-user configuration (REQUIRED on first run) ─────────────────
# Master key for encrypting users' API keys at rest. Generate with:
#   openssl rand -hex 32
# Must be 64 hex characters. NEVER rotate without re-encrypting the DB —
# losing it makes all stored API keys unreadable.
KEYS_ENCRYPTION_KEY=

# First-run bootstrap admin. The server creates this account on first
# startup if no users exist yet. After login, remove both lines from .env.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Session signing secret (any random string). Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Server ───────────────────────────────────────────────────────────
PORT=18790
# SQLite + uploads live here. In Docker this should be a mounted volume.
# DATA_DIR=/app/data

# ── Optional shared API keys (fallback when no per-user key is set) ──
# Per-user keys, set via the Account page, always take precedence.
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPGRAM_API_KEY=...

# ── Optional ─────────────────────────────────────────────────────────
# Override default MCP config path
# MCP_CONFIG_PATH=/path/to/mcp-config.json
# Override default model
# CLAUDE_MODEL=claude-sonnet-4-20250514
# Gateway API key for native iOS app — if set, /chat from non-logged-in
# clients requires X-Gateway-Key header
# GATEWAY_API_KEY=your-secret-key-here
# Override the built-in voice-assistant system prompt entirely
# VOICE_ASSISTANT_PROMPT="You are my cooking assistant. Reply in one short sentence unless I ask for steps."
# Cap image blocks per /chat API call (default 2; min 1)
# MAX_VISION_CONTEXT_IMAGES=2
