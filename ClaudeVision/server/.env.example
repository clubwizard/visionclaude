# ── Multi-user configuration (REQUIRED on first run) ─────────────────
# Master key for encrypting users' API keys at rest. Generate with:
#   openssl rand -hex 32
# Must be 64 hex characters. NEVER rotate without re-encrypting the DB —
# losing it makes all stored API keys unreadable.
KEYS_ENCRYPTION_KEY=

# First-run bootstrap admin. The server creates this account on first
# startup if no users exist yet. After login, remove both lines from .env.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Session signing secret (any random string). Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Server ───────────────────────────────────────────────────────────
PORT=18790
# SQLite + uploads live here. In Docker this should be a mounted volume.
# DATA_DIR=/app/data

# ── Optional shared API keys (admin-only fallback) ──
# Per-user keys, set via the Account page, always take precedence.
# Only the admin account falls back to these — invitees must BYO.
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPGRAM_API_KEY=...
# OPENAI_API_KEY=sk-...  # for the OpenAI voices in the voice picker

# ── Password recovery (Postmark) ─────────────────────────────────────
# If both are set, /auth/forgot-password sends reset emails via Postmark.
# If unset, the server logs reset URLs to the console instead — useful
# for local dev, useless for prod. The From address MUST be a verified
# sender signature (or come from a verified domain) in your Postmark
# account, otherwise sends bounce with HTTP 422.
# POSTMARK_API_KEY=
# POSTMARK_FROM_EMAIL=noreply@your-domain.com

# Used to build the reset link in forgot-password emails. If unset, the
# server falls back to the request's Host + Forwarded-Proto, which works
# locally but breaks if the email is opened on a different network than
# the request came in on. Set this on prod.
# PUBLIC_BASE_URL=https://aside.example.com

# ── Optional ─────────────────────────────────────────────────────────
# Allow cross-origin browser requests from specific domains (comma-separated).
# Leave unset to block all cross-origin requests (recommended for most installs).
# CORS_ORIGINS=https://your-domain.com
# Override default MCP config path
# MCP_CONFIG_PATH=/path/to/mcp-config.json
# Override default model
# CLAUDE_MODEL=claude-sonnet-4-20250514
# Gateway API key for native iOS app — if set, /chat from non-logged-in
# clients requires X-Gateway-Key header
# GATEWAY_API_KEY=your-secret-key-here
# Override the built-in voice-assistant system prompt entirely
# VOICE_ASSISTANT_PROMPT="You are my cooking assistant. Reply in one short sentence unless I ask for steps."
# Cap image blocks per /chat API call (default 2; min 1)
# MAX_VISION_CONTEXT_IMAGES=2
