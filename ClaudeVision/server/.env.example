ANTHROPIC_API_KEY=sk-ant-...
PORT=18790
# Password for the web voice client login page
ADMIN_PASSWORD=choose-a-strong-password
# Optional: Deepgram API key for Aura TTS + Nova STT (browser fallback used if absent)
# DEEPGRAM_API_KEY=...
# Optional: override default MCP config path
# MCP_CONFIG_PATH=/path/to/mcp-config.json
# Optional: default model
# CLAUDE_MODEL=claude-sonnet-4-20250514
# Optional: gateway API key (if set, all non-health endpoints require X-Gateway-Key header)
# GATEWAY_API_KEY=your-secret-key-here
# Optional: override the built-in voice-assistant system prompt entirely
# VOICE_ASSISTANT_PROMPT="You are my cooking assistant. Reply in one short sentence unless I ask for steps."
